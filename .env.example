# =====================================================================
#  OfficeHub — cấu hình. Copy thành .env rồi điền giá trị:
#     cp .env.example .env
#  Quy ước: Section__Key  (2 dấu gạch dưới) ↔ appsettings "Section:Key".
#  Dòng có  [BẮT BUỘC]  thiếu là app không khởi động và báo tên biến.
#  Giá trị mặc định bên dưới chạy được ngay với: docker compose -f infra/docker-compose.dev.yml up -d
# =====================================================================

# ---------- Chung ----------
ASPNETCORE_ENVIRONMENT=Development
# [BẮT BUỘC] Tên hiển thị và URL public (link trong email mời / quên mật khẩu)
App__Name=OfficeHub
App__BaseUrl=http://localhost:5173

# ---------- PostgreSQL ----------
# Dùng cho container postgres (docker compose)
POSTGRES_DB=officehub
POSTGRES_USER=officehub
POSTGRES_PASSWORD=officehub_dev_password
# [BẮT BUỘC] Chuỗi kết nối cho Api. Production (trong Docker): Host=postgres
ConnectionStrings__Default=Host=localhost;Port=5432;Database=officehub;Username=officehub;Password=officehub_dev_password
# Tự chạy migration khi khởi động Api
Database__MigrateOnStartup=true

# ---------- Tài khoản admin đầu tiên ----------
# Chỉ dùng khi DB chưa có admin. Sau lần chạy đầu nên xoá mật khẩu khỏi file này.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe123
Seed__AdminFullName=Quản trị hệ thống

# ---------- Khoá mã hoá (cookie đăng nhập, dữ liệu nhạy cảm) ----------
# [BẮT BUỘC] Api và Realtime phải dùng CHUNG thư mục này. Mất thư mục = mọi người bị đăng xuất
# và dữ liệu đã mã hoá không giải được → phải sao lưu cùng DB.
DataProtection__KeysPath=.keys

# ---------- Văn phòng ----------
# [BẮT BUỘC] Múi giờ tính công
Office__TimeZone=Asia/Ho_Chi_Minh
# Dải IP public của văn phòng (CIDR, cách nhau dấu phẩy) → chấm công "tại văn phòng"; ngoài dải = "từ xa"
# Xem IP văn phòng: mở https://ifconfig.me khi đang ở văn phòng
Office__IpRanges=
# Không hoạt động quá N phút trong văn phòng ảo → trạng thái "Vắng"
Office__InactiveMinutes=15

# ---------- S3 (file hợp đồng, hồ sơ, avatar) ----------
# [BẮT BUỘC] AWS: để trống S3__ServiceUrl, S3__ForcePathStyle=false
#            MinIO / RustFS / S3-compatible: điền ServiceUrl, ForcePathStyle=true
S3__Region=ap-southeast-1
S3__ServiceUrl=http://localhost:9000
S3__ForcePathStyle=true
S3__AccessKey=devaccesskey
S3__SecretKey=devsecretkey123
S3__BucketFiles=officehub-files
# Thư mục gốc trong bucket khi bucket dùng chung với dự án khác (ví dụ officehub/). Để trống = gốc bucket.
# File nghiệp vụ → {KeyPrefix}files/…, backup → {KeyPrefix}backup/…, bản build FE → {KeyPrefix}web/…
S3__KeyPrefix=
# Thời hạn link tải file (phút)
S3__PresignMinutes=5
# Dùng cho script backup + deploy FE (không bắt buộc với Api)
S3__BucketBackup=officehub-backup
S3__BucketWeb=officehub-web

# ---------- Email (SMTP) ----------
# [BẮT BUỘC] Dev: Mailpit bắt mọi email, xem tại http://localhost:8025
# Production: Amazon SES / Gmail Workspace / nhà cung cấp SMTP bất kỳ
Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseSsl=false
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=no-reply@example.com
Smtp__FromName=OfficeHub

# ---------- Realtime (văn phòng 3D) — tuỳ chọn ----------
# Địa chỉ Api để Realtime kiểm tra phiên đăng nhập (tài khoản bị khoá → bị đẩy khỏi văn phòng)
Realtime__ApiBaseUrl=http://localhost:5080
# Chu kỳ kiểm tra lại phiên của người đang online (giây)
Realtime__SessionCheckSeconds=30

# ---------- Voice (LiveKit) — tuỳ chọn, để trống = tắt voice ----------
# ApiSecret phải dài TỐI THIỂU 32 ký tự. Tạo ngẫu nhiên: openssl rand -base64 32
LiveKit__Url=ws://localhost:7880
LiveKit__ApiKey=devkey
LiveKit__ApiSecret=dev_livekit_secret_at_least_32_characters

# ---------- Giám sát — tuỳ chọn ----------
# Seq: xem log tại http://localhost:5341
Seq__Url=http://localhost:5341
Seq__ApiKey=
# Sentry: để trống = tắt
Sentry__Dsn=

# ---------- Chỉ dùng cho production (infra/docker-compose.yml) ----------
# Domain trỏ về VPS, email nhận thông báo chứng chỉ Let's Encrypt
APP_DOMAIN=office.example.com
VOICE_DOMAIN=voice.example.com
ACME_EMAIL=admin@example.com
# Image Docker (GitHub Container Registry)
IMAGE_REGISTRY=ghcr.io/your-org/officehub
IMAGE_TAG=latest
# Mật khẩu đăng nhập giao diện Seq trên production
SEQ_ADMIN_PASSWORD=
