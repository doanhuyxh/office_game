{
  "name": "officehub-agent-runner",
  "private": true,
  "type": "module",
  "description": "Bộ điều phối agent: nhận tin đánh thức Telegram từ OfficeHub, kiểm tra việc qua MCP, chạy CLI agent trong worktree riêng, tạo PR (TEST-44)",
  "scripts": {
    "start": "bun src/cli.ts start",
    "doctor": "bun src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile dist/officehub-runner"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
